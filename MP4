package com.mycompany.studentenrollmentproject;

import java.util.Scanner;

public class MP4 {

    private static final Scanner scanner = new Scanner(System.in);
    private static final Course course = new Course();

    public static void main(String[] args) {
        try (scanner) {
            boolean running = true;
            
            while (running) {
                displayMenu();
                String choice = scanner.nextLine().trim();
                
                try {
                    switch (choice) {
                        case "1" -> enrollMenu();
                            
                        case "2" -> dropMenu();
                            
                        case "3" -> course.displayAllLearners();
                            
                        case "4" -> findMenu();
                            
                        case "0" -> {
                            running = false;
                            System.out.println("Program ended.");
                        }
                            
                        default -> System.out.println("Invalid menu choice.");
                    }
                    
                } catch (EnrollmentException e) {
                    System.out.println("Error: " + e.getMessage());
                }
            }
        }
    }

    private static void displayMenu() {
        System.out.println("\n=== Student Enrollment Management ===");
        System.out.println("1. Enroll");
        System.out.println("2. Drop");
        System.out.println("3. List");
        System.out.println("4. Find");
        System.out.println("0. Exit");
        System.out.print("Enter choice: ");
    }

    private static void enrollMenu() throws EnrollmentException {
        System.out.print("Enter learner ID: ");
        String idInput = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(idInput);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        System.out.print("Enter learner name: ");
        String name = scanner.nextLine();

        course.enrollLearner(id, name);
    }

    private static void dropMenu() throws EnrollmentException {
        System.out.print("Enter learner ID to drop: ");
        String idInput = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(idInput);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        course.dropLearner(id);
    }

    private static void findMenu() throws EnrollmentException {
        System.out.print("Enter learner ID to find: ");
        String idInput = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(idInput);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        course.findLearner(id);
    }
}

enum EnrollmentStatus {
    ACTIVE,
    DROPPED
}

class EnrollmentException extends Exception {

    public EnrollmentException(String message) {
        super(message);
    }
}

class Learner {

    private final int id;
    private final String name;
    private EnrollmentStatus status;

    public Learner(int id, String name) {
        this.id = id;
        this.name = name;
        this.status = EnrollmentStatus.ACTIVE;
    }

    public int getId() {
        return id;
    }

    public EnrollmentStatus getStatus() {
        return status;
    }

    public void setStatus(EnrollmentStatus status) {
        this.status = status;
    }

    @Override
    public String toString() {
        return "ID: " + id
                + " | Name: " + name
                + " | Status: " + status;
    }
}

class Course {

    private final Learner[] learners = new Learner[3];
    private int learnerCount = 0;

    public void enrollLearner(int id, String name)
            throws EnrollmentException {

        if (id <= 0) {
            throw new EnrollmentException(
                    "ID must be a positive number.");
        }

        if (name == null || name.trim().isEmpty()) {
            throw new EnrollmentException(
                    "Learner name cannot be empty.");
        }

        for (int i = 0; i < learnerCount; i++) {
            if (learners[i].getId() == id) {
                throw new EnrollmentException(
                        "Duplicate learner ID.");
            }
        }

        if (learnerCount == learners.length) {
            throw new EnrollmentException(
                    "Course is full.");
        }

        learners[learnerCount] = new Learner(id, name.trim());

        System.out.println("Learner enrolled successfully.");
        System.out.println(learners[learnerCount]);

        learnerCount++;
    }

    public void dropLearner(int id)
            throws EnrollmentException {

        for (int i = 0; i < learnerCount; i++) {
            if (learners[i].getId() == id) {

                if (learners[i].getStatus()
                        == EnrollmentStatus.DROPPED) {

                    throw new EnrollmentException(
                            "Learner already dropped.");
                }

                learners[i].setStatus(
                        EnrollmentStatus.DROPPED);

                System.out.println(
                        "Learner dropped successfully.");
                System.out.println(learners[i]);
                return;
            }
        }

        throw new EnrollmentException(
                "Learner not found.");
    }

    public void displayAllLearners() {
        if (learnerCount == 0) {
            System.out.println("No learners enrolled.");
            return;
        }

        System.out.println("\nAll Learners:");

        for (int i = 0; i < learnerCount; i++) {
            System.out.println(
                    (i + 1) + ". " + learners[i]);
        }
    }

    public void findLearner(int id)
            throws EnrollmentException {

        for (int i = 0; i < learnerCount; i++) {
            if (learners[i].getId() == id) {
                System.out.println("Learner found:");
                System.out.println(learners[i]);
                return;
            }
        }

        throw new EnrollmentException(
                "Learner not found.");
    }
}
