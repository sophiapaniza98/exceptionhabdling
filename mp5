package com.mycompany.libraryborrowingandreturnsystem;

import java.util.Scanner;

public class mp5 {

    private static final Scanner scanner = new Scanner(System.in);
    private static final Library library = new Library();

    public static void main(String[] args) {
        try (scanner) {
            boolean running = true;
            
            while (running) {
                displayMenu();
                String choice = scanner.nextLine().trim();
                
                try {
                    switch (choice) {
                        case "1" -> borrowMenu();
                            
                        case "2" -> returnMenu();
                            
                        case "3" -> findMenu();
                            
                        case "4" -> library.displayAllBooks();
                            
                        case "0" -> {
                            running = false;
                            System.out.println("Program ended.");
                        }
                            
                        default -> System.out.println("Invalid menu choice.");
                    }
                    
                } catch (LibraryException e) {
                    System.out.println("Error: " + e.getMessage());
                    
                } finally {
                    System.out.println();
                }
            }
        }
    }

    private static void displayMenu() {
        System.out.println("=== Library Borrowing and Return System ===");
        System.out.println("1. Borrow");
        System.out.println("2. Return");
        System.out.println("3. Find");
        System.out.println("4. List");
        System.out.println("0. Exit");
        System.out.print("Enter choice: ");
    }

    private static void borrowMenu() throws LibraryException {
        System.out.print("Enter book ID: ");
        String input = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(input);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        library.borrow(id);
    }

    private static void returnMenu() throws LibraryException {
        System.out.print("Enter book ID: ");
        String input = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(input);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        library.returnCopy(id);
    }

    private static void findMenu() throws LibraryException {
        System.out.print("Enter book ID: ");
        String input = scanner.nextLine().trim();

        int id;

        try {
            id = Integer.parseInt(input);
        } catch (NumberFormatException e) {
            System.out.println("Error: Enter a valid number.");
            return;
        }

        library.findBook(id);
    }
}

class LibraryException extends Exception {

    public LibraryException(String message) {
        super(message);
    }
}

class Book {

    private final int id;
    private final String title;
    private int availableCopies;
    private int borrowedCopies;

    public Book(int id, String title, int availableCopies) {
        this.id = id;
        this.title = title;
        this.availableCopies = availableCopies;
        this.borrowedCopies = 0;
    }

    public int getId() {
        return id;
    }

    public String getTitle() {
        return title;
    }

    public int getAvailableCopies() {
        return availableCopies;
    }

    public int getBorrowedCopies() {
        return borrowedCopies;
    }

    public void borrowCopy() throws LibraryException {
        if (availableCopies == 0) {
            throw new LibraryException("No copies available.");
        }

        availableCopies--;
        borrowedCopies++;
    }

    public void returnCopy() throws LibraryException {
        if (borrowedCopies == 0) {
            throw new LibraryException(
                    "No borrowed copies to return.");
        }

        borrowedCopies--;
        availableCopies++;
    }

    @Override
    public String toString() {
        return "ID: " + id
                + " | Title: " + title
                + " | Available: " + availableCopies
                + " | Borrowed: " + borrowedCopies;
    }
}

class Library {

    private final Book[] books;

    public Library() {
        books = new Book[3];

        books[0] = new Book(1, "Java Basics", 2);
        books[1] = new Book(2, "Algorithms", 1);
        books[2] = new Book(3, "Databases", 0);
    }

    public void borrow(int id) throws LibraryException {
        Book book = getBook(id);

        book.borrowCopy();

        System.out.println("Book borrowed successfully.");
        System.out.println(book);
    }

    public void returnCopy(int id) throws LibraryException {
        Book book = getBook(id);

        book.returnCopy();

        System.out.println("Book returned successfully.");
        System.out.println(book);
    }

    public void findBook(int id) throws LibraryException {
        Book book = getBook(id);

        System.out.println("Book found:");
        System.out.println(book);
    }

    public void displayAllBooks() {
        System.out.println("All Books:");

        for (Book book : books) {
            System.out.println(book);
        }
    }

    private Book getBook(int id) throws LibraryException {
        for (Book book : books) {
            if (book.getId() == id) {
                return book;
            }
        }

        throw new LibraryException("Book not found.");
    }
}
